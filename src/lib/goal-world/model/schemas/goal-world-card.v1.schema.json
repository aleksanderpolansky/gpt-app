{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arctor://schemas/goal-world-card/v1",
  "title": "ARCTor Goal World Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "revision",
    "currentStateProjection"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldId",
        "actorId",
        "lifecycleStatusCode",
        "currentRevisionId",
        "currentRevisionNumber",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "lifecycleStatusCode": {
          "enum": [
            "draft",
            "definition_ready",
            "compiled",
            "ready_for_activity_intake",
            "active",
            "paused",
            "completed",
            "abandoned"
          ]
        },
        "currentRevisionId": {
          "type": "string",
          "minLength": 1
        },
        "currentRevisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "worldId",
        "revisionNumber",
        "previousRevisionId",
        "revisionReasonCode",
        "sourceGoalStatement",
        "goalDefinitionRef",
        "terminalObjectiveId",
        "objectives",
        "objectMemberships",
        "targetCriteria",
        "goalHypotheses",
        "unknownCodes",
        "protocolRefs",
        "createdAt"
      ],
      "properties": {
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "previousRevisionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisionReasonCode": {
          "enum": [
            "initial_definition",
            "user_refinement",
            "new_reality_evidence",
            "changed_resources",
            "changed_constraints",
            "feasibility_correction",
            "changed_life_context",
            "other"
          ]
        },
        "sourceGoalStatement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statementId",
            "exactText",
            "recordedAt"
          ],
          "properties": {
            "statementId": {
              "type": "string",
              "minLength": 1
            },
            "exactText": {
              "type": "string",
              "minLength": 1
            },
            "recordedAt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "goalDefinitionRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goalDefinitionRevisionId",
            "sourceGoalStatementId",
            "schemaVersion",
            "completenessPercent"
          ],
          "properties": {
            "goalDefinitionRevisionId": {
              "type": "string",
              "minLength": 1
            },
            "sourceGoalStatementId": {
              "type": "string",
              "minLength": 1
            },
            "schemaVersion": {
              "type": "integer",
              "minimum": 1
            },
            "completenessPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "terminalObjectiveId": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectiveId",
              "objectiveRoleCode",
              "parentObjectiveId",
              "label",
              "primaryTargetValueObjectId",
              "originCode"
            ],
            "properties": {
              "objectiveId": {
                "type": "string",
                "minLength": 1
              },
              "objectiveRoleCode": {
                "enum": [
                  "terminal",
                  "intermediate",
                  "supporting"
                ]
              },
              "parentObjectiveId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "primaryTargetValueObjectId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "originCode": {
                "enum": [
                  "actor_declared_terminal",
                  "compiler_derived",
                  "user_added"
                ]
              }
            }
          }
        },
        "objectMemberships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valueObjectId",
              "roleCodes",
              "orientationCode",
              "objectiveIds",
              "note"
            ],
            "properties": {
              "valueObjectId": {
                "type": "string",
                "minLength": 1
              },
              "roleCodes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "target",
                    "prerequisite",
                    "constraint",
                    "resource",
                    "support",
                    "indicator",
                    "context",
                    "risk"
                  ]
                },
                "uniqueItems": true
              },
              "orientationCode": {
                "enum": [
                  "approach",
                  "avoid",
                  "maintain",
                  "neutral"
                ]
              },
              "objectiveIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "targetCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "objectiveId",
              "valueObjectId",
              "parameterCode",
              "comparatorCode",
              "targetValue",
              "targetValueUpper",
              "unitCode",
              "definitionText",
              "ruleRef"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1
              },
              "objectiveId": {
                "type": "string",
                "minLength": 1
              },
              "valueObjectId": {
                "type": "string",
                "minLength": 1
              },
              "parameterCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "comparatorCode": {
                "enum": [
                  "eq",
                  "gte",
                  "lte",
                  "range",
                  "contains",
                  "state_is",
                  "custom_rule"
                ]
              },
              "targetValue": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "targetValueUpper": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "unitCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "definitionText": {
                "type": "string"
              },
              "ruleRef": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "entityType",
                      "entityId"
                    ],
                    "properties": {
                      "entityType": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entityId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "goalHypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesisId",
              "summary",
              "statusCode",
              "evidenceRefs",
              "proposedAt"
            ],
            "properties": {
              "hypothesisId": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "statusCode": {
                "const": "proposal_only"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entityType",
                    "entityId"
                  ],
                  "properties": {
                    "entityType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entityId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "proposedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unknownCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protocolRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocolCode",
              "version",
              "contentHash"
            ],
            "properties": {
              "protocolCode": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "contentHash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "currentStateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOf",
        "items"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valueObjectId",
              "parameterCode",
              "observedOrDerivedValue",
              "unitCode",
              "effectiveAt",
              "observedAt",
              "knownAt",
              "provenanceRefs",
              "derivationRef"
            ],
            "properties": {
              "valueObjectId": {
                "type": "string",
                "minLength": 1
              },
              "parameterCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedOrDerivedValue": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "unitCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effectiveAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "knownAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenanceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entityType",
                    "entityId"
                  ],
                  "properties": {
                    "entityType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entityId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "derivationRef": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "entityType",
                      "entityId"
                    ],
                    "properties": {
                      "entityType": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entityId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arctor.app/contracts/search-dispatch-v1.json",
  "title": "ARCTor M0099 exact UUID lookup vs suggest by text",
  "description": "Design-only dispatch. Requires server authorization; cannot prove runtime RLS. The $defs are pinned to accepted M0097 and M0098 snapshots.",
  "oneOf": [
    {
      "$ref": "#/$defs/exactRequest"
    },
    {
      "$ref": "#/$defs/suggestRequest"
    }
  ],
  "$defs": {
    "exactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "objectId",
        "locale",
        "actorScope"
      ],
      "properties": {
        "mode": {
          "const": "exact_uuid_lookup"
        },
        "objectId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "pl",
            "es",
            "de",
            "cs",
            "uk",
            "ru",
            "und"
          ],
          "description": "und means explicitly unknown; never silently map to English."
        },
        "actorScope": {
          "type": "string",
          "enum": [
            "global_only",
            "global_and_own"
          ],
          "description": "Requested visibility only. Server derives authenticated actor and must enforce tenant boundaries."
        }
      }
    },
    "suggestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "query"
      ],
      "properties": {
        "mode": {
          "const": "suggest_by_text"
        },
        "query": {
          "$ref": "#/$defs/queryRequest"
        }
      }
    },
    "queryRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "locale",
        "actorScope",
        "intent",
        "limit",
        "filters"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]*$",
          "description": "Trimmed/nonempty, <=512 Unicode code points; no implicit normalization or UUID lookup in M0097."
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "pl",
            "es",
            "de",
            "cs",
            "uk",
            "ru",
            "und"
          ],
          "description": "und means explicitly unknown; never silently map to English."
        },
        "actorScope": {
          "type": "string",
          "enum": [
            "global_only",
            "global_and_own"
          ],
          "description": "Requested visibility only. Server derives authenticated actor and must enforce tenant boundaries."
        },
        "intent": {
          "type": "string",
          "enum": [
            "identify",
            "suggest",
            "explore"
          ],
          "description": "User purpose, not a ranking stage/match_class or UUID-lookup command."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rootObjectId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "parentObjectId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "objectKindCodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
              }
            },
            "nodeRoleCodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
              }
            }
          },
          "description": "Optional refinements only; never widen server-authorized visibility; codes and referenced UUIDs require registry and permission checks."
        }
      }
    },
    "searchResult": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "ARCTOR_SEMANTIC_SEARCH_RESULT_V1"
        },
        "queryLocale": {
          "enum": [
            "en",
            "pl",
            "es",
            "de",
            "cs",
            "uk",
            "ru",
            "und"
          ]
        },
        "outcome": {
          "enum": [
            "single_candidate",
            "ambiguous",
            "no_match",
            "blocked"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objectId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "match_class": {
                "enum": [
                  "exact",
                  "alias",
                  "partial",
                  "lexical",
                  "vector",
                  "graph"
                ]
              },
              "displayTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "displayLocale": {
                "enum": [
                  "en",
                  "pl",
                  "es",
                  "de",
                  "cs",
                  "uk",
                  "ru",
                  "und"
                ]
              },
              "displayEvidenceStatus": {
                "enum": [
                  "source_verified",
                  "translation_verified"
                ]
              },
              "path": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "verified",
                      "unverified"
                    ]
                  },
                  "alternatives": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 15,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "objectId": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        },
                        "required": [
                          "objectId",
                          "title"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "status",
                  "alternatives"
                ]
              },
              "score": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "semantics": {
                    "enum": [
                      "exact_binary",
                      "alias_binary",
                      "partial_coverage",
                      "lexical_bm25_raw",
                      "vector_cosine",
                      "graph_evidence_raw"
                    ]
                  },
                  "status": {
                    "enum": [
                      "computed",
                      "not_computed"
                    ]
                  },
                  "calibrated": {
                    "const": false
                  },
                  "comparisonScope": {
                    "const": "within_match_class_only"
                  }
                },
                "required": [
                  "value",
                  "semantics",
                  "status",
                  "calibrated",
                  "comparisonScope"
                ]
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sourceTable": {
                    "enum": [
                      "value_objects",
                      "concept_aliases",
                      "value_object_definition_versions",
                      "platform_localized_content_v1",
                      "derived_vector",
                      "derived_graph"
                    ]
                  },
                  "sourceField": {
                    "enum": [
                      "title",
                      "description",
                      "definition",
                      "canonical_key",
                      "alias",
                      "path",
                      "negative_context"
                    ]
                  },
                  "sourceLocale": {
                    "enum": [
                      "en",
                      "pl",
                      "es",
                      "de",
                      "cs",
                      "uk",
                      "ru",
                      "und"
                    ]
                  },
                  "sourceVersion": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 180
                  },
                  "sourceRecordHash": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "identityJoinVerified": {
                    "const": true
                  },
                  "scopeClass": {
                    "enum": [
                      "global_public",
                      "owner_private"
                    ]
                  },
                  "serverAuthorizationVerified": {
                    "const": true
                  }
                },
                "required": [
                  "sourceTable",
                  "sourceField",
                  "sourceLocale",
                  "sourceVersion",
                  "sourceRecordHash",
                  "identityJoinVerified",
                  "scopeClass",
                  "serverAuthorizationVerified"
                ]
              },
              "version": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "catalog_snapshot_hash": {
                    "const": "sha256:v1:e68d4c397e6d7286cc883c219470869d586933c98a66362be92886f88f16299f"
                  },
                  "translation_version": {
                    "const": "derived-sha256-v1:b2b7110d065d5e215aeef7069cff8312a8553ba9d6f4b50febd3ae35bdb111c2"
                  },
                  "definition_version": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                },
                "required": [
                  "catalog_snapshot_hash",
                  "translation_version",
                  "definition_version"
                ]
              }
            },
            "required": [
              "objectId",
              "rank",
              "match_class",
              "displayTitle",
              "displayLocale",
              "displayEvidenceStatus",
              "path",
              "score",
              "provenance",
              "version"
            ]
          }
        },
        "clarificationQuestion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 500
        },
        "selectedObjectId": {
          "type": "null"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog_snapshot_hash": {
              "const": "sha256:v1:e68d4c397e6d7286cc883c219470869d586933c98a66362be92886f88f16299f"
            },
            "translation_version": {
              "const": "derived-sha256-v1:b2b7110d065d5e215aeef7069cff8312a8553ba9d6f4b50febd3ae35bdb111c2"
            }
          },
          "required": [
            "catalog_snapshot_hash",
            "translation_version"
          ]
        }
      },
      "required": [
        "contract",
        "queryLocale",
        "outcome",
        "candidates",
        "clarificationQuestion",
        "selectedObjectId",
        "snapshot"
      ]
    },
    "exactResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "outcome",
        "objectId",
        "selectedObjectId",
        "serverAuthorizationVerified",
        "identityJoinVerified"
      ],
      "properties": {
        "mode": {
          "const": "exact_uuid_lookup"
        },
        "outcome": {
          "enum": [
            "found",
            "not_available"
          ]
        },
        "objectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedObjectId": {
          "type": "null"
        },
        "serverAuthorizationVerified": {
          "const": true
        },
        "identityJoinVerified": {
          "const": true
        }
      }
    },
    "suggestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "searchResult"
      ],
      "properties": {
        "mode": {
          "const": "suggest_by_text"
        },
        "searchResult": {
          "$ref": "#/$defs/searchResult"
        }
      }
    }
  }
}
